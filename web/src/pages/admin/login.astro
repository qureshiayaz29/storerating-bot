---
const bot = process.env.BOT_USERNAME || 'storeratingbot';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>StoreRating Admin</title>
    <style>
      :root { color-scheme: light dark; --bg: #f7f7f5; --fg: #17181c; --muted: #5d6270; }
      @media (prefers-color-scheme: dark) { :root { --bg: #0e1219; --fg: #eef1f6; --muted: #9aa4b6; } }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--fg);
        font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; padding: 24px 16px; text-align: center; }
      p { color: var(--muted); }
      a.cta { display: inline-block; margin-top: 8px; padding: 12px 20px; border-radius: 10px; background: #34d399; color: #06221a; font-weight: 600; text-decoration: none; }
    </style>
  </head>
  <body>
    <main>
      <img src="/logo.svg" alt="" width="88" height="88" style="border-radius: 20px" />
      <h1>StoreRating Admin</h1>
      <p>Tap the button, then tap the link the bot sends you.<br />Or send <code>/login</code> to @{bot} yourself.</p>
      <a class="cta" href={`https://t.me/${bot}?start=login`}>Log in with Telegram</a>
    </main>
  </body>
</html>
