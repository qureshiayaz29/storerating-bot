# Copy to .env for local development. Never commit .env.
# In production these live in GitHub repository secrets and Vercel environment variables.

# Telegram
BOT_TOKEN=
ADMIN_CHAT_ID=
WEBHOOK_SECRET=

# Database — Supabase connection string using the storerating_app role
# (transaction pooler for Vercel, direct or session pooler for the daily job)
DATABASE_URL=

# Claude
ANTHROPIC_API_KEY=
MONTHLY_BUDGET_USD=30
CLAUDE_ENABLED=true

# Store Source
STORE_SOURCE=google_play_scraper
STORE_SOURCE_FALLBACK=

# Web project (Vercel)
SESSION_SECRET=
CRON_SECRET=
GITHUB_DISPATCH_TOKEN=
